# Bit Studio backend. Copy to .env and fill in.
# NEVER commit .env. NEVER expose these to the frontend bundle.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=True

# Comma-separated. Add your Render hostname in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Postgres. Use the POOLED connection string (host contains "-pooler").
# Neon runs pgbouncer in transaction mode, so persistent connections must be
# disabled — see CONN_MAX_AGE in settings.py. Leave blank to use local SQLite.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Comma-separated origins allowed to call the API (the marketing site).
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://bitstudio.co.zw,https://www.bitstudio.co.zw
