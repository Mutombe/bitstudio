# Copy to .env.local for local development.
#
# WARNING: every VITE_* variable is inlined into the public JS bundle.
# Anything here is visible to anyone who opens devtools. Put only the
# API's public base URL here. Never a key, token, or password.

# Leave blank to disable lead capture (forms still hand off to WhatsApp/email).
VITE_API_URL=http://localhost:8000
