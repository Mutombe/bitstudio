# Production API base for the CRM, baked in at build time (Vite production mode).
# This is a PUBLIC URL, not a secret — safe to commit. It's what connects the
# admin at bitstudio.co.zw to the Django backend on Render.
#
# The frontend authenticates with a token in the Authorization header (see
# src/lib/api.js), so this can be a different registrable domain from the site
# without the cross-site cookie problem a session login would hit.
#
# When the API later moves behind api.bitstudio.co.zw, change this to that URL.
VITE_API_URL=https://bitstudio-crm-api.onrender.com
